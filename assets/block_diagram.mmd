flowchart TD
    WIDECAM["wide IMX477 (fixed)
    nvarguscamerasrc, 1920x1080@30fps"]
    WIDEDET["YoloDetector + TrackManager
    (wide's own instances)"]
    MAP["WideHandoffMapper.pixel_to_goal()
    calibrated wide-px -> absolute ticks"]

    TELECAM["telephoto IMX477 (on gimbal)
    nvarguscamerasrc, 1920x1080@30fps"]
    TELEDET["YoloDetector + TrackManager
    (telephoto's own instances)"]
    ERR["pixel error
    target point - frame center"]
    GAIN["ProportionalGain (pan + tilt)
    kp * error, with deadband"]

    CTRL["PanTiltController
    clamp, sync-write goal"]
    U2D2["U2D2 adapter
    /dev/ttyUSB0, TTL serial"]
    PAN["XL330 pan servo (id=1)
    firmware position PID + profile vel/accel"]
    TILT["XL330 tilt servo (id=2)
    firmware position PID + profile vel/accel"]
    PIP["PipRtspRelay
    compose_pip(), optional"]
    RTSP["RTSP server
    x264enc, optional"]

    TELECAM -- "frame: ndarray (BGR)" --> TELEDET
    TELEDET -- "has lock: Detection" --> ERR
    ERR -- "pixel_error_x/y: float" --> GAIN
    GAIN -- "pan/tilt_delta: int (ticks)" --> CTRL

    TELEDET -. "no lock this frame" .-> WIDECAM
    WIDECAM -- "frame: ndarray (BGR)" --> WIDEDET
    WIDEDET -- "target_point (wide px)" --> MAP
    MAP -- "absolute goal ticks" --> CTRL

    CTRL -- "goal_position: int (sync write)" --> U2D2
    U2D2 -- "TTL serial packet" --> PAN
    U2D2 -- "TTL serial packet" --> TILT
    PAN -. "physically aims" .-> TELECAM
    TILT -. "physically aims" .-> TELECAM
    TELECAM -. "frame: ndarray (BGR)" .-> PIP
    WIDECAM -. "frame: ndarray (BGR), inset" .-> PIP
    PIP -. "composited frame" .-> RTSP
